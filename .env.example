# Django settings
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_LOG_LEVEL=INFO

# Static / Media (optional — defaults work for dev)
# DJANGO_STATIC_ROOT=/home/youruser/Fitness-Hub/staticfiles
# DJANGO_MEDIA_ROOT=/home/youruser/Fitness-Hub/media

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
